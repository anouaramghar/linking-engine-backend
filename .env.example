# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://linkmesh:linkmesh@127.0.0.1:15432/linkmesh

# The test suite writes and deletes rows and refuses to run against the database
# above. Point it at a disposable one instead - see docs/testing.md.
# TEST_DATABASE_URL=postgresql+psycopg://linkmesh:linkmesh@127.0.0.1:15432/linkmesh_test

# --- Redis (RQ task queue) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
# Commit this build was made from, normally set by the image build rather than
# by hand. Reported beside the evaln be traced back
# to the code that produced it. Empty is reported as unknown.
BUILD_COMMIT=unknown
# Required X-API-Key header on all non-health endpoints; set a non-empty local value.
# A blank value fails closed and leailable.
API_KEY=
# JSON object mapping trusted human keys. Operator
# keys can use protected routes and are required for approval/reactivation audit actions.
# Example: {"alice":"replace-with-a-bob-key"}
OPERATOR_API_KEYS={}
# Pepper for HMAC-SHA256 hashes of  and login codes.
# Set a long random value in every non-development environment.
API_KEY_PEPPER=
# Dashboard login via Telegram. Run scripts/setup-telegram-login.sh to fill
# these three in — creating a bot ican do.
# Blank disables dashboard login, which leaves the UI unauthenticated: never
# deploy the proxy with auth_requesty.
TELEGRAM_BOT_TOKEN=
# The bot's username, without a lea
TELEGRAM_BOT_USERNAME=
# Numeric Telegram user ID pre-apprWithout it the
# first login is a pending request nobody can approve.
DASHBOARD_BOOTSTRAP_ADMIN_ID=

# Sliding dashboard session lifetim
DASHBOARD_SESSION_TTL_MINUTES=720
# Lifetime of the one-time Telegram
DASHBOARD_LOGIN_NONCE_TTL_SECONDS=300
LIVE_URL_TIMEOUT_SECONDS=8
LIVE_URL_MAX_REDIRECTS=5
MAX_ACTIVE_JOBS_PER_TENANT=100
# Generate once with: python -c "from cryptography.fernet import Fernet;
print(Fernet.generate_key().decode(
# Required outside development and whenever WordPress credentials are stored.
CREDENTIAL_ENCRYPTION_KEY=
# During key rotation, list previous keys here, separated by commas. Remove them
# after the rotation migration has dential.
CREDENTIAL_DECRYPTION_KEYS=

# --- Customer crawl and analysis bounds ---
# Protected routes fail closed untis also apply
# when a remote customer site omits or lies about pagination metadata.
CRAWL_MAX_DURATION_SECONDS=1800
CRAWL_MAX_ARTICLES=10000
CRAWL_MAX_SITEMAPS=100
CRAWL_MAX_SITEMAP_URLS=10000
CRAWL_MAX_WORDPRESS_PAGES=1000
CRAWL_MAX_RESPONSE_BYTES=10000000
CRAWL_MAX_ARTICLE_CHARS=100000
CRAWL_MAX_LINKS_PER_ARTICLE=1000
CRAWL_MAX_TOTAL_LINKS=100000
ANALYSIS_MAX_ARTICLES_PER_SITE=10000
ANALYSIS_MAX_CORPUS_ARTICLES=20000

# --- Publication ---
# Links publication may place inside an article's prose. Suggestions past this
# still publish, as the appended "Rn-text placement.
PUBLISH_MAX_IN_TEXT_LINKS_PER_ARTICLE=3
# Minimum characters between two aubles the guard.
PUBLISH_MIN_IN_TEXT_GAP_CHARS=300
# Pause between source articles in he densest write
# traffic LinkMesh sends a customer site. 429/503 Retry-After is always honoured.
PUBLISH_REQUEST_DELAY_SECONDS=0.5
# Publication generates placements the review queue never did, before writing.
# Each is a model call; past this mppended block.
# 0 disables preflight and restores lazy-only generation.
PUBLISH_MAX_PLACEMENT_CALLS_PER_RUN
PUBLISH_PLACEMENT_CONCURRENCY=4
# Consecutive failed attempts aftertined as 'failed'
# instead of being retried by every future publication run.
PUBLISH_MAX_SUGGESTION_ATTEMPTS=3

# --- Operations alerts (empty = lo
ALERT_WEBHOOK_URL=

# --- Crawl safety ---
# The crawler refuses private/loopbts and requires
# HTTPS for WP credentials and content-pool sources. true relaxes both, e.g. for a WordPress
# test site on localhost. DevelopmeRONMENT=development.
ALLOW_UNSAFE_CRAWL_TARGETS=false

# A crawl below this fraction of the previous successful article count fails
# without reconciling the site's cu
INGESTION_MIN_PREVIOUS_RATIO=0.5

# --- External content pool (RSS + Wikipedia) ---
POOL_MAX_ARTICLES_PER_SOURCE=50
POOL_SOURCE_TIMEOUT=20
# Maximum decoded response size, stsize.
POOL_MAX_RESPONSE_BYTES=5000000
POOL_MAX_ARTICLE_CHARS=100000
POOL_MAX_TITLE_CHARS=500
# Identify LinkMesh and provide a rders.
POOL_HTTP_USER_AGENT=LinkMesh/0.1 (contact: linkmesh@example.com)
# Pause between paginated Wikipedia
POOL_REQUEST_DELAY_SECONDS=1
# Comma-separated exact parent domalookalikes are not.
POOL_ALLOWED_DOMAINS=wikipedia.org
# Quarantine after this many termin
POOL_QUARANTINE_FAILURE_THRESHOLD=3
POOL_POLL_INTERVAL_SECONDS=86400
POOL_POLL_REPEAT_COUNT=3650

# --- Evaluation history ---
# One idempotent orphan-page snapsh
EVALUATION_SNAPSHOT_INTERVAL_SECONDS=86400
EVALUATION_SNAPSHOT_REPEAT_COUNT=36

# --- External search (v3 - leave e
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.
TAVILY_TIMEOUT_SECONDS=10
TAVILY_MAX_RESULTS_PER_REQUEST=5

# --- Citation-need detection (loca
CITATION_NEED_THRESHOLD=0.65
CITATION_NEED_MAX_ARTICLE_CHARS=300
CITATION_NEED_MAX_SENTENCES=500
CITATION_NEED_MAX_RESULTS=10

# --- Placement context (v4) ---
# Which passage of the source article a suggested link belongs in. Generated on
# demand when an editor opens a sugow.
# Leave the key empty to turn the feature off: the drawer says so, and nothing
# else in the review queue changes.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrou
# Any OpenRouter chat model. `:free` variants of the same slug exist but are
# rate limited hard enough to be un
PLACEMENT_MODEL=google/gemma-4-31b-it
PLACEMENT_TIMEOUT_SECONDS=60
# How much of the source article the model is shown, in characters.
PLACEMENT_MAX_SOURCE_CHARS=12000
PLACEMENT_MAX_OUTPUT_TOKENS=800

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1
EMBEDDING_DEVICE=cpu

# --- Hybrid suggestion contract ---
# Each run processes at most this mree slots.
# With the default per-source cap, one run creates at most 150 suggestions.
HYBRID_MAX_SOURCES_PER_RUN=50
# Active suggestions per site stay reviewable; reviewed/expired rows free slots.
HYBRID_MAX_ACTIVE_SUGGESTIONS_PER_S
# Hybrid exposes the top three BM25-ranked suggestions per source.
HYBRID_MAX_SUGGESTIONS_PER_ARTICLE=
# Standing bound on links LinkMesh may ever add to one article. The cap above
# frees a slot once a suggestion isery run keeps
# proposing new targets for a source it has already linked from. Rejections
# still free their slot; applied li
HYBRID_MAX_LIFETIME_LINKS_PER_ARTICLE=5
# Do not create suggestions below ty.
SUGGESTION_MIN_SCORE=0.50
# A target this similar to the sournk candidate.
# Applied to both halves of the Hybrid candidate union.
SUGGESTION_DUPLICATE_SIMILARITY_THR
# Navigational and transactional pages are never worth linking to. Both lists
# are JSON arrays and the shipped de in another
# language should replace them rather than append. Titles match the whole title,
# case-insensitively; slugs match ogin" excludes
# /login/ but keeps /guide-to-login-security/. Slugs are literals, not patterns.
# An empty array turns that half of when unset.
# LOW_VALUE_TARGET_TITLES=["connexion","panier","conditions générales"]
# LOW_VALUE_TARGET_URL_SLUGS=["connenerales"]