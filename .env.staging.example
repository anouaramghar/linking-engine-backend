# Copy to .env.staging, replace every replace-* value, and keep the result out
# of Git. This profile isolates its project, ports, database, and Redis volume
# from a developer's normal LinkMesh stack.
COMPOSE_PROJECT_NAME=linkmesh-staging
LINKMESH_ENV_FILE=.env.staging
LINKMESH_IMAGE=linkmesh-engine:staging

POSTGRES_USER=linkmesh_staging
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=linkmesh_staging
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=16379
API_HOST_PORT=18000
LINKMESH_DATABASE_URL=postgresql+psycopg://linkmesh_staging:replace-with-url-encoded-database-password@db:5432/linkmesh_staging
LINKMESH_REDIS_URL=redis://redis:6379/0

ENVIRONMENT=production
API_KEY=
OPERATOR_API_KEYS={"staging-operator":"replace-with-a-long-operator-key"}
API_KEY_PEPPER=replace-with-a-long-random-pepper
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
CREDENTIAL_DECRYPTION_KEYS=

# Telegram is optional for the API/content-pool pilot. Configure it before a
# dashboard/nginx staging deployment that enforces browser sessions.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# DASHBOARD_BOOTSTRAP_ADMIN_ID=123456789

ALLOW_UNSAFE_CRAWL_TARGETS=false
ALERT_WEBHOOK_URL=

# Add only exact parent domains reviewed by the team. Subdomains are accepted;
# lookalike domains are not.
POOL_ALLOWED_DOMAINS=wikipedia.org,jpl.nasa.gov
POOL_MAX_ARTICLES_PER_SOURCE=10
POOL_SOURCE_TIMEOUT=20
POOL_MAX_RESPONSE_BYTES=5000000
POOL_MAX_ARTICLE_CHARS=100000
POOL_MAX_TITLE_CHARS=500
POOL_HTTP_USER_AGENT=LinkMesh-staging/0.1 (contact: replace-with-operations-email)
POOL_REQUEST_DELAY_SECONDS=1
POOL_QUARANTINE_FAILURE_THRESHOLD=3
POOL_POLL_INTERVAL_SECONDS=86400
POOL_POLL_REPEAT_COUNT=3650

# Paid providers stay off during connector validation.
TAVILY_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
